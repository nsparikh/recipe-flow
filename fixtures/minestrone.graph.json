    { "id": "s8", "type": "cook", "label": "Simmer uncovered", "details": "Until the pasta is al dente.", "sourceInstruction": "Simmer uncovered until the pasta is al dente, about 20 minutes.", "station": "stove", "equipment": ["Dutch oven"], "activeTimeMin": 0, "passiveTimeMin": 20, "temperature": "low", "optional": false, "inferred": false, "activeTimeEstimated": true, "passiveTimeEstimated": false },
